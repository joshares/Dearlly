# Dearlly settings for LOCAL development only.
# Copy to .env (`cp .env.example .env`). The values below are safe placeholders, not real secrets.
# Production secrets are set on the server with deploy/set-secret.sh and never go in git.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL 16)
POSTGRES_USER=dearlly
POSTGRES_PASSWORD=local-dev-only-not-a-secret
POSTGRES_DB=dearlly
DATABASE_URL=postgresql+asyncpg://dearlly:local-dev-only-not-a-secret@postgres:5432/dearlly

# Redis (games, rate limits, Celery)
REDIS_URL=redis://redis:6379/0

# Used to sign tokens. Production refuses to start with this placeholder.
SECRET_KEY=local-dev-only-not-a-secret-change-on-server

# Comma-separated. Production refuses "*" and plain http:// origins.
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ORIGINS=http://localhost:3100
PUBLIC_WEB_URL=http://localhost:3100

# Emails are logged, not sent, unless this is "resend" (Stage 3). Production requires resend.
EMAIL_DELIVERY=log
EMAIL_FROM=Dearlly <hello@dearlly.localhost>
# RESEND_API_KEY is set on the server only (deploy/set-secret.sh), never here.

# Cloudflare Turnstile (bot check). These are Cloudflare's public TEST keys: they always pass.
# Production refuses the test secret; the real keys are set on the server in Stage 3.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Where browsers reach the API (Google returns people here after sign-in).
PUBLIC_API_URL=http://localhost:8100

# "Continue with Google" stays hidden until both are set. The secret goes on the server only
# (deploy/set-secret.sh), never here. Steps to create them come in Stage 3.
GOOGLE_CLIENT_ID=

# Error alerts (Sentry). Leave empty locally; set on the server with set-secret.sh.
SENTRY_DSN=

# Behind Cloudflare this becomes CF-Connecting-IP (Stage 3). Empty = direct connection address.
CLIENT_IP_HEADER=

# Web app (Next.js). API_INTERNAL_URL is how the web container reaches the API inside Docker.
NEXT_PUBLIC_API_URL=http://localhost:8100
API_INTERNAL_URL=http://api:8000

# Ports on your Mac (127.0.0.1 only). 3100/8100 avoid clashing with other projects on 3000/8000.
WEB_PORT=3100
API_PORT=8100
